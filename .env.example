# Database
DATABASE_URL=postgresql://user:password@localhost:5432/meeting_intelligence

# Redis
REDIS_URL=redis://redis:6379/0

# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Whisper
WHISPER_MODEL=base  # tiny, base, small, medium, large-v3
WHISPER_DEVICE=cpu  # cpu or cuda
WHISPER_COMPUTE_TYPE=int8  # int8, float16, float32

# Google Calendar
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Microsoft Outlook (optional)
MICROSOFT_CLIENT_ID=your_client_id_here
MICROSOFT_CLIENT_SECRET=your_secret_here
MICROSOFT_REDIRECT_URI=http://localhost:8000/auth/microsoft/callback

# Notification Services
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_password

# API
API_HOST=0.0.0.0
API_PORT=8000

# WebRTC
WEBRTC_STUN_SERVER=stun:stun.l.google.com:19302

# Storage
AUDIO_STORAGE_PATH=/tmp/meeting-audio
TRANSCRIPT_STORAGE_PATH=/tmp/transcripts

# Authentication
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change_me_to_a_random_value_of_at_least_32_characters
ADMIN_EMAILS=admin@example.com
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
SESSION_MAX_DAYS=30
PASSWORD_RESET_MINUTES=30
# Where the reset link in the e-mail points (your frontend page); optional
PASSWORD_RESET_URL=http://localhost:3000/reset-password
SMTP_FROM=
ALLOW_REGISTRATION=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ENABLE_DOCS=true
ENABLE_GOOGLE_OAUTH=false
EXPENSIVE_LIMIT_PER_HOUR=30
REGISTER_LIMIT_PER_HOUR=10
REFRESH_LIMIT_PER_HOUR=600
